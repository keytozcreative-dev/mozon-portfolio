# Copy this file to `.env` (never commit `.env`).
#
# Optional: the URL the contact form POSTs to.
# Leave empty and the form will honestly tell visitors it isn't connected yet
# and offer to open their email app instead.
#
# Examples:
#   Formspree:          https://formspree.io/f/xxxxxxxx
#   Bundled Express API: https://your-api.onrender.com/api/contact
VITE_CONTACT_ENDPOINT=
